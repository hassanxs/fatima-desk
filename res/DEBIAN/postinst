#!/bin/bash

set -e

if [ "$1" = configure ]; then

	INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
	ln -f -s /usr/share/fatimadesk/fatimadesk /usr/bin/fatimadesk

	if [ "systemd" == "$INITSYS" ]; then

		if [ -e /etc/systemd/system/fatimadesk.service ]; then
			rm -f /etc/systemd/system/fatimadesk.service /usr/lib/systemd/system/fatimadesk.service /usr/lib/systemd/user/fatimadesk.service >/dev/null  2>&1
		fi
		mkdir -p /usr/lib/systemd/system/
		cp /usr/share/fatimadesk/files/systemd/fatimadesk.service /usr/lib/systemd/system/fatimadesk.service
		# try fix error in Ubuntu 18.04
		# Failed to reload fatimadesk.service: Unit fatimadesk.service is not loaded properly: Exec format error.
		# /usr/lib/systemd/system/fatimadesk.service:10: Executable path is not absolute: pkill -f "fatimadesk --"
		if [ -e /usr/bin/pkill ]; then
			sed -i "s|pkill|/usr/bin/pkill|g" /usr/lib/systemd/system/fatimadesk.service
		fi
		systemctl daemon-reload
		systemctl enable fatimadesk
		systemctl start fatimadesk
	fi
fi
